#include <iostream>
#include <iomanip>

using namespace std;

class Autopilot {
private:
    double courseAngle;
    double altitude;

public:
    Autopilot(double C, double H) {
        courseAngle = C;
        altitude = H;
    }
    void changeCourse(double delta) {
        courseAngle += delta;
    }
    void changeAltitude(double delta) {
        altitude += delta;
    }
    void printStatus() {
        setlocale(LC_ALL, "Russian");
        cout << "Курс: " << courseAngle << " градусов, высота: " << altitude << " м" << endl;
    }
};

int main()
{
    Autopilot a1(90, 1000);
    a1.changeCourse(10);
    a1.changeAltitude(500);
    a1.printStatus();
    return 0;
}
