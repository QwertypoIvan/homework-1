#include <iostream>
#include <vector>
#include <iomanip>

int main() {
    setlocale(LC_ALL, "Russian");
    const double v0 = 50.0;
    const double g = 9.8;
    const double dt = 1.0;
    if (v0 <= 0) {
        std::cout << "Начальная скорость должна быть больше нуля" << std::endl;
        return 1;
    }
    std::vector<double> times;
    std::vector<double> heights
    times.reserve((int)(v0 * 2.0 / g / dt));
    heights.reserve((int)(v0 * 2.0 / g / dt));
    for (double t = 0.0; t <= 1000.0; t += dt) {
        double h = v0 * t - 0.5 * g * t * t;
        if (h < 0) {
            break;
        }
        else {
            times.push_back(t);
            heights.push_back(h);
        }
    }

    std::cout << "Таблица \"время — высота\":\n" << std::endl;
    std::cout << std::setw(10) << "Время (с)" << std::setw(15) << "Высота (м)" << std::endl;
    std::cout << std::string(25, '-') << std::endl;

    for (size_t i = 0; i < times.size(); i++) {
        std::cout << std::setw(10) << std::fixed << std::setprecision(1) << times[i]
            << std::setw(15) << std::fixed << std::setprecision(2) << heights[i]
            << std::endl;
    }

    return 0;
}

