#include <iostream>
#include <vector>
#include <iomanip>
#include <cmath>

using namespace std;

struct Point {
	double x, y, z;
};

int main() {
	setlocale(LC_ALL, "Russian");
	double vx = 30.0, vy = 20.0, vz = 40.0;
	double dt = 0.01;
	double t_max = 5.0;

	vector<Point> traj;
	traj.reserve((t_max / dt) + 1);
	double x = 0.0, y = 0.0, z = 0.0;

	for (double t = 0.0; t <= t_max; t += dt) {
		traj.push_back({ x, y, z });
		x += vx * dt;
		y += vy * dt;
		z += vz * dt;
	}

	cout << "Без ускорений:" << endl;
	cout << setw(8) << "Время" << setw(12) << "X" << setw(12) << "Y" << setw(12) << "Z" << endl;
	cout << string(44, '-') << endl;

	for (int i = 0; i < traj.size(); ++i) {
		cout << setw(9) << fixed << setprecision(2) << (i * dt)
			<< setw(13) << fixed << setprecision(3) << traj[i].x
			<< setw(13) << fixed << setprecision(3) << traj[i].y
			<< setw(13) << fixed << setprecision(3) << traj[i].z << endl;
	}
	cout << "Проверка: последняя точка должна быть (150.00, 100.00, 200.00)" << endl;



	cout << "\nВариант решения задания с учетом ускорений свободного падения и сопротивления воздуха\n";

	vx = 30.0; vy = 20.0; vz = 40.0;
	x = 0.0; y = 0.0; z = 0.0;
	const double g = 9.8;
	const double cD = 0.1;

	vector<Point> traj_adv;
	traj_adv.reserve((t_max / dt) + 1);
	for (double t = 0.0; t <= t_max; t += dt) {
		traj_adv.push_back({ x, y, z });
		double v = sqrt(vx * vx + vy * vy + vz * vz);
		double ax = -cD * vx * v;
		double ay = -cD * vy * v;
		double az = -g - cD * vz * v;

		vx += ax * dt;
		vy += ay * dt;
		vz += az * dt;

		x += vx * dt;
		y += vy * dt;
		z += vz * dt;
	}

	cout << setw(8) << "Время" << setw(12) << "X" << setw(12) << "Y" << setw(12) << "Z" << endl;
	cout << string(44, '-') << endl;

	for (int i = 0; i < traj_adv.size(); ++i) {
		cout << setw(9) << fixed << setprecision(2) << (i * dt)
			<< setw(13) << fixed << setprecision(3) << traj_adv[i].x
			<< setw(13) << fixed << setprecision(3) << traj_adv[i].y
			<< setw(13) << fixed << setprecision(3) << traj_adv[i].z << endl;
	}
	return 0;
}
