#include <iostream>
#include <vector>
#include <iomanip>
using namespace std;

int main() {
    setlocale(LC_ALL, "Russian");
    const double v0 = 50.0;
    const double g = 9.8;
    const double dt = 1.0;
    if (v0 <= 0) {
        cout << "Начальная скорость должна быть больше нуля" << endl;
        return 1;
    }
    vector<double> times;
    vector<double> heights;
    times.reserve((int)(v0 * 2.0 / g / dt));
    heights.reserve((int)(v0 * 2.0 / g / dt));
    for (double t = 0.0; t <= 1000.0; t += dt) {
        double h = v0 * t - 0.5 * g * t * t;
        if (h < 0) {
            break;
        }
        else {
            times.push_back(t);
            heights.push_back(h);
        }
    }

    cout << "Таблица \"время — высота\":\n" << endl;
    cout << setw(10) << "Время (с)" << setw(15) << "Высота (м)" << endl;
    cout << string(25, '-') << endl;

    for (size_t i = 0; i < times.size(); i++) {
        cout << setw(10) << fixed << setprecision(1) << times[i]
            << setw(15) << fixed << setprecision(2) << heights[i]
            << endl;
    }

    if (heights.empty()) {
        cout << "Данных нет (вектор пуст)." << endl;
    }
    else {
        size_t idx_max = 0;
        for (size_t i = 1; i < heights.size(); ++i) {
            if (heights[i] > heights[idx_max]) {
                idx_max = i;
            }
        }
        cout << "Максимальная высота: " << fixed << setprecision(2) << heights[idx_max] << " м" << endl;
        cout << "Достигнута на секунде: " << fixed << setprecision(1) << times[idx_max] << " с" << endl;
    }
}

