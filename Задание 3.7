#include <iostream>
#include <iomanip>

using namespace std;

class FlightComputer {
private:
    double altitude;
    double velocity;
    double fuel;
    double thrust;
    double time;
public:
    FlightComputer(double A, double V, double F, double T) {
        altitude = A;
        velocity = V;
        fuel = F;
        thrust = T;
        time = 0;
    }
    void simulateStep(double dt)
    {
        velocity += (thrust / 1000 - 9.81) * dt;
        altitude += velocity * dt;
        fuel -= dt * 2;
        time += dt;
    }
    void printStatus() {
        setlocale(LC_ALL,"Russian");
        cout << "t=" << fixed << setprecision(1) << time << "c: "
            << "высота = " << fixed << setprecision(1) << altitude << "м, "
            << "скорость = " << fixed << setprecision(1) << velocity << "м/с, "
            << "топливо = " << fixed << setprecision(1) << fuel << endl;
    }
};

int main()
{
    FlightComputer fc(0, 0, 100, 12000);
    for (int i = 0; i < 5; i++) {
        fc.simulateStep(0.5);
        fc.printStatus();
    }
    return 0;
}
