#include <iostream>
#include <vector>

using namespace std;    

class Engine {
private:
    double thrust;
    double fuelFlow;
    double fuel;

public:
    Engine(double T, double fF, double f) {
        thrust = T;
        fuelFlow = fF;
        fuel = f;
    }
    double getThrust()
    {
        return thrust;
    }
    bool hasFuel()
    {
        return (fuel > 0);
    }
    void burn(double dt)
    {
        if (fuel > 0) { fuel -= fuelFlow * dt; }
    }
    double getFuel()
    {
        return fuel;
    }
};





class Navigation {
private:
    double altitude;
    double velocity;
    double acceleration;
    double mass;

public:
    Navigation(double H, double V, double m)
    {
        altitude = H;
        velocity = V;
        mass = m;
        acceleration = 0;
    }
    void update(double thrust, double dt)
    {
        acceleration = thrust / mass - 9.81;
        velocity += acceleration * dt;
        altitude += velocity * dt;
    }
    void printStatus(double time)
    {
        setlocale(LC_ALL, "Russian");
        cout << "Текущие параметры полёта: \n"
            << "Время: " << time << " с\n"
            << "Высота: " << altitude << " м\n"
            << "Скорость: " << velocity << " м/с\n"
            << "Ускорение: " << acceleration << " м/с^2\n\n";
    }
};





class AutonomousFlightSystem {
private:
    Engine engine;
    Navigation nav;
    double time;

public:
    AutonomousFlightSystem(Engine E, Navigation N)
        : engine(E), nav(N), time(0.0) {}
    void simulate(double dt, double totalTime)
    {
        while (time < totalTime && engine.hasFuel() == true)
        {
            engine.burn(dt);
            nav.update(engine.getThrust(), dt);
            nav.printStatus(time);
            time += dt;
        }
    }
    void printSummary()
    {
        cout << "--- Полет завершен ---" << endl;
        cout << "Оставшееся топливо: " << engine.getFuel() << " кг" << endl;
    }
};

int main()
{
    Engine eng(10000, 10, 30);
    Navigation nav(0, 0, 1000);
    AutonomousFlightSystem AFS(eng, nav);
    AFS.simulate(0.1, 5.0);
    AFS.printSummary();
    return 0;
}
