#include <iostream>
#include <clocale>
using namespace std;

int Lcount(int S, int V, int rho, int CD)
{
    int L;
    L = rho * V * V * S * CD / 2;
    return L;
}

int main()
{
    setlocale(LC_ALL, "Russian");
    int S, V, rho, CD, L;
    cout << "Введите площадь крыла S:";
    cin >> S;
    cout << "Введите скорость полёта V:";
    cin >> V;
    cout << "Введите плотность воздуха rho:";
    cin >> rho;
    cout << "Введите коэффициент аэродинамического сопротивления CD:";
    cin >> CD;
    L = Lcount(S, V, rho, CD);
    printf("Подъёмная сила L = %d", L);
    return 0;
}
